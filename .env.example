# =============================================================================
# Jean-Michel — example .env
# =============================================================================
# Copy this file to `.env` at the repo root and fill in the values you need.
# `.env` is gitignored ; `.env.example` is committed (whitelist in .gitignore).
#
# Values exported in your shell take precedence over `.env`, so you can keep
# defaults here and override one-off for a single run with `KEY=… ./jm.sh`.
# =============================================================================

# ---- API keys for external tools -------------------------------------------

# news_latest / news_archive — NewsData.io (https://newsdata.io)
# Free tier : 200 credits/day, ~12 h delay on /latest, archives within plan.
NEWSDATA_API_KEY=

# github_search_code — GitHub (https://github.com/settings/tokens)
# REQUIRED for /search/code (anonymous calls are refused).
# Generate a fine-grained PAT, read-only on public repos, no extra scopes
# needed. github_search_repos also benefits (60 req/h → 5000 req/h).
GITHUB_TOKEN=

# stackoverflow_search — Stack Exchange API (https://stackapps.com/apps/oauth/register)
# OPTIONAL. Without a key : 300 requests/day per IP. With a key : 10 000/day.
STACKEXCHANGE_KEY=

# ---- Vocal mode (--mode vocal) ---------------------------------------------

# Path to the Piper TTS .onnx model. The .onnx.json config is auto-found
# (same path + .json). See voice_models/README.md for the model catalogue
# and download instructions.
JEANMICHEL_VOICE_MODEL=

# Optional : force a specific audio player command (paplay, aplay, ffplay
# or any equivalent that accepts a WAV path as last argument). Auto-detect
# in that order when unset.
JEANMICHEL_AUDIO_PLAYER=

# ---- Model overrides (rarely needed, defaults are fine) --------------------

# JEANMICHEL_DISPATCH_MODEL=granite4.1:8b
# JEANMICHEL_MAIN_MODEL=gemma4:latest
# JEANMICHEL_COMPACTOR_MODEL=gemma4:latest
# JEANMICHEL_SUBAGENT_MODEL=gemma4:latest
# JEANMICHEL_REASONER_MODEL=gemma4:26b

# ---- Runtime tuning (rarely needed) ----------------------------------------

# OLLAMA_HOST=http://localhost:11434
# JEANMICHEL_LLM_TIMEOUT=120
# JEANMICHEL_REQUEST_TIMEOUT=900
# JEANMICHEL_TURN_TIMEOUT=1800
