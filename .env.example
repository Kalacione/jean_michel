# =============================================================================
# Jean-Michel — example .env
# =============================================================================
# Copy this file to `.env` at the repo root and fill in the values you need.
# `.env` is gitignored ; `.env.example` is committed (whitelist in .gitignore).
#
# Values exported in your shell take precedence over `.env`, so you can keep
# defaults here and override one-off for a single run with `KEY=… ./jm.sh`.
# =============================================================================

# ---- API keys for external tools -------------------------------------------

# news_latest / news_archive — NewsData.io (https://newsdata.io)
# Free tier : 200 credits/day, ~12 h delay on /latest, archives within plan.
NEWSDATA_API_KEY=

# github_search_code — GitHub (https://github.com/settings/tokens)
# REQUIRED for /search/code (anonymous calls are refused).
# Generate a fine-grained PAT, read-only on public repos, no extra scopes
# needed. github_search_repos also benefits (60 req/h → 5000 req/h).
GITHUB_TOKEN=

# stackoverflow_search — Stack Exchange API (https://stackapps.com/apps/oauth/register)
# OPTIONAL. Without a key : 300 requests/day per IP. With a key : 10 000/day.
STACKEXCHANGE_KEY=

# ---- Model & voice config → models.toml ------------------------------------
# Role→model, per-model context windows and the vocal-mode voice all live in
# models.toml (gitignored ; defaults in models.example.toml — copy & edit it).
# The env vars below still OVERRIDE one-off if needed (names in models.example.toml):
#   JEANMICHEL_{DISPATCH,MAIN,CODE,COMPACTOR,SUBAGENT,REASONER}_MODEL
#   JEANMICHEL_CTX_WINDOW_<slug> · JEANMICHEL_VOICE_MODEL · JEANMICHEL_AUDIO_PLAYER

# ---- Runtime tuning (rarely needed) ----------------------------------------

# OLLAMA_HOST=http://localhost:11434
# JEANMICHEL_LLM_TIMEOUT=120
# JEANMICHEL_REQUEST_TIMEOUT=900
# JEANMICHEL_TURN_TIMEOUT=1800

# ---- Per-conversation git snapshots ----------------------------------------
# Off by default. When on, each conversation gets its own local git repo
# (never pushed) and a commit is made at the end of every turn — enabling
# "rewind to a turn" and "fork a new conversation from a point" in the web UI.
# Requires `git` on PATH. Degrades gracefully (no-op) if git is absent.
# JEANMICHEL_CONVERSATION_SNAPSHOT_ENABLED=1

# ---- Code mode : in-place intervention on a real repo (git worktree) --------
# Off by default. When on, a conversation in `--mode code` gets an ISOLATED git
# worktree of the target repo (branch jm/conv-<id>), so the system edits real
# files in place without ever touching your live tree (git = undo). The repo_*
# tools, the context packet, the structured test runner and the deliberation
# layer only activate here. Requires `git`; degrades gracefully (no-op) if off.
# JEANMICHEL_CODE_WORKTREE_ENABLED=1
# The web flow attaches a repo PER PROJECT (Projets → champ "Dépôt de code"). The
# env below is an EXPLICIT CLI global target only; UNSET = no repo (a code-mode
# conversation without an attached repo gets NO worktree — no silent fallback to
# the jean-michel repo itself).
# JEANMICHEL_PROJECT_ROOT=/abs/path/to/repo
# repo_test AUTO-detects the interpreter (target repo's .venv, else jean-michel's) — leave unset
# for the common case. Set only to force a different runner (other stack / non-pytest):
# JEANMICHEL_REPO_TEST_CMD=.venv/bin/python -m pytest -q tests/v2   # relative path → resolved against the source repo
# JEANMICHEL_REPO_TEST_TIMEOUT=300

# ---- MCP client (hosted MCP servers as native tools) -----------------------
# Enabled by copying mcp_servers.example.toml → mcp_servers.toml (lists the
# servers). Requires the optional extra:  pip install -e .[mcp]
# JEANMICHEL_MCP_DISABLED=1               # force-off without deleting the file
# JEANMICHEL_MCP_CALL_TIMEOUT=25          # per-call timeout (seconds)
# JEANMICHEL_MCP_MAX_TOOLS_PER_SERVER=30  # cap to protect the context budget
# Token for the GitHub MCP server referenced by mcp_servers.toml (a GitHub PAT):
# GITHUB_MCP_TOKEN=
